<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply chain hardening (see docs/engineering-backlog.md E-11):
    * clear + single explicit HTTPS source blocks inherited user/machine feeds
    * packageSourceMapping allow-list keeps resolution locked even if a higher-scoped
      nuget.config adds other feeds later (configs merge up the hierarchy)
    * dedicated auditSources pin NuGet Audit to the trusted source regardless of
      what package sources exist (element available since NuGet 6.12)
    * fallback folders disabled

  Stricter opt-in posture, intentionally NOT enabled here:
    signatureValidationMode="require" plus a non-empty trustedSigners section rejects
    any package that is not repository-signed. All recent nuget.org uploads are signed,
    but enabling it can break restore when legacy unsigned versions are introduced.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <auditSources>
    <clear />
    <!-- Serves vulnerability metadata only. In restricted networks where api.nuget.org
         is blocked, swap this value to https://data.nuget.org/v3/index.json -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
