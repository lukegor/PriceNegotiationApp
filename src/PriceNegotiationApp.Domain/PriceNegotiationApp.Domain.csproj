<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Vogen-generated IComparable implementations trigger MA0097 on the declaring partial. -->
    <NoWarn>$(NoWarn);MA0097</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vogen" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Update="Meziantou.Analyzer" Version="3.0.177" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Update="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
